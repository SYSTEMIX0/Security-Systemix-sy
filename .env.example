# انسخ هذا المثال إلى ملف .env محلي خاص بك فقط؛ لا تضع أسراراً في GitHub.
# داخل WebDev تُضاف القيم الحساسة عبر نموذج الأسرار الآمن، لا في ملفات المشروع.
DISCORD_CLIENT_ID=1562540070802563162
DISCORD_CLIENT_SECRET=
# الافتراضي للموقع المنشور. للمعاينة ضع عنوانها HTTPS المطابق تماماً، ولـlocalhost استخدم HTTP محلياً في التطوير فقط.
DISCORD_REDIRECT_URI=https://systemix-hc3hycno.manus.space/api/discord/callback
# غيّره إلى true محلياً فقط عند استخدام Redirect HTTP على localhost/127.0.0.1، واتركه false على الإنتاج.
SYSTEMIX_ALLOW_LOCAL_HTTP_REDIRECT=false
DISCORD_BOT_TOKEN=

# يبقى اتصال Gateway في الإنتاج مغلقاً حتى اختيار استضافة دائمة واختباره.
SYSTEMIX_ENABLE_PRODUCTION_GATEWAY=false

# auto يجرّب Members + Message Content، ثم كل Intent منفرداً، ثم يرجع إلى عدم استخدامهما إذا رفضهما Discord.
# members يطلب Members فقط؛ none يعطّل الـIntents المميزة.
SYSTEMIX_PRIVILEGED_INTENTS=auto

# مفتاح توقيع جلسة اللوحة؛ ولّده عشوائياً (زر Generate في Render).
MANUS_JWT_SECRET=
# معرفات Discord للملاك مفصولة بفواصل، وكلمة المرور تحفظ كـscrypt hash فقط.
SYSTEMIX_OWNER_DISCORD_IDS=
SYSTEMIX_OWNER_PASSWORD_HASH=
# رابط قاعدة MySQL. اتركه فارغاً حتى تتوفر قاعدة فعلية.
DATABASE_URL=
# على الاستضافات الخارجية مثل Render: true لإنشاء جداول Systemix تلقائياً عند التشغيل.
SYSTEMIX_AUTO_MIGRATE=false
# MANUS_OAUTH_API_URL خاص بتسجيل دخول Manus الاختياري؛ لا تحتاجه على Render.
